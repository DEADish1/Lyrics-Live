# LyricsLive Environment Variables

# API Base URL
# Leave commented to use default local API routes (/api)
# Uncomment and set to use external Python microservice
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Future: Authentication
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key

# Future: Database
# DATABASE_URL=postgresql://user:password@localhost:5432/lyricslive
